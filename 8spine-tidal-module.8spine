const MY_MODULE = {
  id: "com.8spine.module.tidal",
  name: "TIDAL",
  version: "1.0.1",
  labels: ["TIDAL", "LOSSLESS", "DOLBY_ATMOS", "STREAMING"],

  searchTracks: (query, limit) => {
    const PUBLIC_TOKEN = "49YxDN9a2aFV6RTG";
    const BASE_URL = "https://api.tidal.com";

    const params = new URLSearchParams();
    params.set("query", query);
    params.set("limit", String(limit));
    params.set("tidal:mediaArtist", "");
    params.set("tidal:mediaTrack", "");
    params.set("tidal:mediaAlbum", "");
    params.set("tidal:music", "Track");

    return fetch(`${BASE_URL}/v1/search?${params.toString()}`, {
      method: "GET",
      headers: {
        Accept: "application/json",
        Authorization: `Bearer ${PUBLIC_TOKEN}`
      }
    })
      .then(res => {
        if (!res.ok) {
          throw new Error(`TIDAL search failed: ${res.status}`);
        }
        return res.json();
      })
      .then(data => {
        const tracks = (data.tracks || []).map(track => ({
          id: track.id,
          title: track.name,
          artist: track.artist ? track.artist.name : "",
          album: track.album ? track.album.name : "",
          duration: track.duration || 0,
          albumCover: track.album ? track.album.imageUrl : null
        }));

        return {
          tracks: tracks,
          total: tracks.length
        };
      });
  },

  getTrackStreamUrl: (trackId, quality) => {
    const PUBLIC_TOKEN = "49YxDN9a2aFV6RTG";
    const BASE_URL = "https://api.tidal.com";

    const qualityMap = {
      DOLBY_ATMOS: "DOLBY_ATMOS",
      HI_RES_LOSSLESS: "HI_RES_LOSSLESS",
      LOSSLESS: "LOSSLESS",
      HIGH: "HIGH",
      LOW: "LOW"
    };

    const targetQuality = qualityMap[quality] || "LOSSLESS";

    return fetch(
      `${BASE_URL}/v1/tracks/${encodeURIComponent(trackId)}/playbackInfo`,
      {
        method: "GET",
        headers: {
          Accept: "application/json",
          Authorization: `Bearer ${PUBLIC_TOKEN}`
        }
      }
    )
      .then(res => {
        if (!res.ok) {
          throw new Error(`TIDAL playbackInfo failed: ${res.status}`);
        }
        return res.json();
      })
      .then(data => {
        const track = data.tracks && data.tracks[0];

        if (!track) {
          return null;
        }

        let streamUrl = null;

        if (targetQuality === "DOLBY_ATMOS") {
          streamUrl =
            (track.audio &&
              track.audio.DolbyAtmos &&
              track.audio.DolbyAtmos.url) ||
            (track.audio &&
              track.audio.hifi &&
              track.audio.hifi.url) ||
            (track.audio &&
              track.audio.lossless &&
              track.audio.lossless.url);
        } else if (targetQuality === "HI_RES_LOSSLESS") {
          streamUrl =
            (track.audio &&
              track.audio.hifi &&
              track.audio.hifi.url) ||
            (track.audio &&
              track.audio.lossless &&
              track.audio.lossless.url);
        } else if (targetQuality === "LOSSLESS") {
          streamUrl =
            track.audio &&
            track.audio.lossless &&
            track.audio.lossless.url;
        } else if (targetQuality === "HIGH") {
          streamUrl =
            track.audio &&
            track.audio.high &&
            track.audio.high.url;
        } else if (targetQuality === "LOW") {
          streamUrl =
            track.audio &&
            track.audio.standard &&
            track.audio.standard.url;
        }

        if (!streamUrl) {
          return null;
        }

        return {
          streamUrl: streamUrl,
          track: {
            id: trackId,
            audioQuality: targetQuality
          }
        };
      });
  }
};

return MY_MODULE;
