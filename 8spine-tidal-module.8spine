const MY_MODULE = {
  id: "com.8spine.module.tidal",
  name: "TIDAL",
  version: "1.0.0",
  labels: ["TIDAL", "LOSSLESS", "DOLBY_ATMOS", "STREAMING"],

  searchTracks: async (query, limit) => {
    const PUBLIC_TOKEN = "49YxDN9a2aFV6RTG";
    const BASE_URL = "https://api.tidal.com";

    const params = new URLSearchParams({
      query: query,
      limit: String(limit),
      "tidal:mediaArtist": "",
      "tidal:mediaTrack": "",
      "tidal:mediaAlbum": "",
      "tidal:music": "Track"
    });

    const response = await fetch(
      `${BASE_URL}/v1/search?${params.toString()}`,
      {
        method: "GET",
        headers: {
          Accept: "application/json",
          Authorization: `Bearer ${PUBLIC_TOKEN}`
        }
      }
    );

    if (!response.ok) {
      throw new Error(
        `TIDAL search failed: ${response.status} ${response.statusText}`
      );
    }

    const data = await response.json();

    const tracks = (data.tracks || []).map(track => ({
      id: track.id,
      title: track.name,
      artist: track.artist?.name || "",
      album: track.album?.name || "",
      duration: track.duration || 0,
      albumCover: track.album?.imageUrl || null
    }));

    return {
      tracks,
      total: tracks.length
    };
  },

  getTrackStreamUrl: async (trackId, quality) => {
    const PUBLIC_TOKEN = "49YxDN9a2aFV6RTG";
    const BASE_URL = "https://api.tidal.com";

    const qualityMap = {
      DOLBY_ATMOS: "DOLBY_ATMOS",
      HI_RES_LOSSLESS: "HI_RES_LOSSLESS",
      LOSSLESS: "LOSSLESS",
      HIGH: "HIGH",
      LOW: "LOW"
    };

    const targetQuality = qualityMap[quality] || "LOSSLESS";

    const response = await fetch(
      `${BASE_URL}/v1/tracks/${encodeURIComponent(trackId)}/playbackInfo`,
      {
        method: "GET",
        headers: {
          Accept: "application/json",
          Authorization: `Bearer ${PUBLIC_TOKEN}`
        }
      }
    );

    if (!response.ok) {
      throw new Error(
        `TIDAL playbackInfo failed: ${response.status} ${response.statusText}`
      );
    }

    const data = await response.json();
    const track = data.tracks?.[0];

    if (!track) {
      return null;
    }

    let streamUrl = null;

    if (targetQuality === "DOLBY_ATMOS") {
      streamUrl =
        track.audio?.DolbyAtmos?.url ||
        track.audio?.hifi?.url ||
        track.audio?.lossless?.url;
    } else if (targetQuality === "HI_RES_LOSSLESS") {
      streamUrl =
        track.audio?.hifi?.url ||
        track.audio?.lossless?.url;
    } else if (targetQuality === "LOSSLESS") {
      streamUrl = track.audio?.lossless?.url;
    } else if (targetQuality === "HIGH") {
      streamUrl = track.audio?.high?.url;
    } else if (targetQuality === "LOW") {
      streamUrl = track.audio?.standard?.url;
    }

    if (!streamUrl) {
      return null;
    }

    return {
      streamUrl,
      track: {
        id: trackId,
        audioQuality: targetQuality
      }
    };
  }
};

return MY_MODULE;
